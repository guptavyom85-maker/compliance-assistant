# Local development configuration. Copy this file to .env and replace secrets.
DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# OpenRouter - never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_JUDGE_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_FALLBACK_MODELS=openrouter/free
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_RETRY_OUTPUT_TOKENS=8192

# Local retrieval models.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RETRIEVAL_MODE=dense
RAG_TOP_K=5
RAG_CONFIDENCE_THRESHOLD=0.3

# Optional local limits.
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=500
MAX_QUESTION_CHARS=2000
APP_LOG_LEVEL=INFO
